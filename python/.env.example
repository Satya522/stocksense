# ===================================
# StockSense — Environment Variables
# ===================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git — it contains secrets!
#     .env is already in .gitignore.
# ===================================

# --- ERPNext REST API ---
ERPNEXT_URL=http://localhost:8000
ERPNEXT_API_KEY=your_key_here
ERPNEXT_API_SECRET=your_secret_here

# --- MariaDB Direct Connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_erpnext_site_db
